# Configuración de Flask
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=una_clave_super_secreta_y_larga_12345

# ============================================
# ENTORNO: Cambiar según necesidad
# ============================================
# development = XAMPP local (para desarrollo)
# production  = Railway (para usuarios/producción)
FLASK_ENV=development

# ============================================
# BASE DE DATOS - PRODUCCIÓN (Railway)
# ============================================
# Descomentar esta línea en Railway (producción)
# Railway configurará automáticamente DATABASE_URL
# DATABASE_URL=mysql://root:PASSWORD@MySQL.railway.internal:3306/railway

# ============================================
# BASE DE DATOS - DESARROLLO (XAMPP Local)
# ============================================
# Estas variables se usan cuando FLASK_ENV=development
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=sistema_empresas

# ============================================
# CONFIGURACIÓN DE ARCHIVOS
# ============================================
UPLOAD_FOLDER=uploads
